# Rails Backend Environment Variables Example
# Copy this file to .env and fill in the actual values

# Database Configuration
POSTGRES_DB=gatareview_development
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Google OAuth Configuration
GOOGLE_CLIENT_ID=# Same as frontend - get from Google Cloud Console
GOOGLE_CLIENT_SECRET=# Same as frontend - get from Google Cloud Console

# reCAPTCHA Configuration
RECAPTCHA_SECRET_KEY=# Get from Google reCAPTCHA (server-side key)
RECAPTCHA_ALLOWED_HOSTNAMES=www.gatareview.com,gatareview.com

# JWT Configuration
SECRET_KEY_BASE=# Generate with: rails secret
JWT_SECRET_KEY=
# Required in production: generate a dedicated random key with at least 32 bytes.
# ruby -rsecurerandom -e 'puts SecureRandom.hex(32)'
# Leave unset in development/test to derive an environment-specific key.

# Production Database Configuration (for deployment)
# DATABASE_URL=postgres://username:password@host:port/database_name
# Production always requires TLS certificate and hostname verification (sslmode=verify-full).
# Do not keep sslmode=require from the provider URI; boot is refused with it.
# For a provider CA (e.g. Aiven), deploy the CA file separately and set its path.
# DATABASE_SSL_CA=/app/config/certs/aiven-ca.pem

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# Rails Environment
RAILS_ENV=development
RACK_ENV=development

# Admin Configuration (comma-separated)
ADMIN_EMAILS=admin@example.com

# Abuse prevention
AUTH_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_FIVE_MINUTES=300

# Optional error monitoring (production only); keep the DSN out of Git.
SENTRY_DSN=

# Notes
# - `site_settings` は環境変数ではなく migration で作成されます
# - review access を使う本番環境では `ADMIN_EMAILS` を設定してください
