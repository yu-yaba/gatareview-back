.git
.gitignore
.DS_Store

# Environment files (never bake secrets into images)
.env
.env.*
!.env.example

# Local/runtime artifacts
log
tmp
storage
vendor/bundle
.bundle

# Credentials and local review artifacts must not enter deployment images.
config/master.key
config/credentials/*.key
*.sql
*.sql.gz
output
.playwright-cli
playwright-report
test-results
