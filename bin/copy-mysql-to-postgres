#!/usr/bin/env bash
# MySQL のデータを、db:schema:load 済みの PostgreSQL にテーブルごとに写す。
#
#   MYSQL_DEFAULTS_FILE=<mysql の接続設定ファイル> MYSQL_DATABASE=<DB名> \
#   PG_URL=<postgres:// で始まる接続先> bin/copy-mysql-to-postgres
#
# - 写す列は PostgreSQL 側の列に合わせる（MySQL にだけある未使用列は写さない）。
# - schema_migrations / ar_internal_metadata は db:schema:load が作った値をそのまま使う。
# - 写す先のテーブルにデータがあれば止める。切替前のリハーサルなどで上書きしてよいときだけ
#   ALLOW_TRUNCATE=yes を付ける（本番の切替後に誤って流すと、それまでの書き込みが消える）。
# - 写したあと主キーの採番を最大値の次に合わせる。
# - 先に MySQL の全テーブルを作業ファイルへ書き出し、そのあと PostgreSQL 側は1つのトランザクションで
#   「空にする → 全テーブルを読み込む → 採番を合わせる」を行う。途中で失敗すれば PostgreSQL は元のまま残る。
# - PostgreSQL は NUL 文字（U+0000）を保存できないので、書き出したデータに含まれていれば何も変えずに止める。
# - パスワードはコマンドに書かない。MySQL は設定ファイル、PostgreSQL は PG_URL か ~/.pgpass を使う。
set -euo pipefail

: "${MYSQL_DEFAULTS_FILE:?set MYSQL_DEFAULTS_FILE}"
: "${MYSQL_DATABASE:?set MYSQL_DATABASE}"
: "${PG_URL:?set PG_URL}"

# 外部キーの順（参照される側が先）
TABLES=(users lectures reviews bookmarks thanks site_settings)

mysql_query() {
  mysql --defaults-extra-file="$MYSQL_DEFAULTS_FILE" --batch --raw --skip-column-names \
    --default-character-set=utf8mb4 "$MYSQL_DATABASE" -e "$1"
}

psql_run() {
  psql "$PG_URL" -v ON_ERROR_STOP=1 -X -q "$@"
}

# PostgreSQL の COPY（text 形式）の書式で1列を出す。NULL は \N、\ と改行・復帰・タブはエスケープする。
read -r -d '' COPY_TEMPLATE <<'SQL' || true
IFNULL(REPLACE(REPLACE(REPLACE(REPLACE(CAST(`COLUMN` AS CHAR), '\\', '\\\\'), '\n', '\\n'), '\r', '\\r'), '\t', '\\t'), '\\N')
SQL

copy_expression() {
  printf '%s' "${COPY_TEMPLATE//COLUMN/$1}"
}

existing=$(psql_run -At -c "SELECT $(for t in "${TABLES[@]}"; do printf "(SELECT COUNT(*) FROM %s) + " "$t"; done) 0")
if [ "$existing" != "0" ]; then
  if [ "${ALLOW_TRUNCATE:-}" != "yes" ]; then
    echo "The target already has ${existing} rows. Refusing to overwrite it (set ALLOW_TRUNCATE=yes only for a rehearsal)." >&2
    exit 1
  fi
  echo "ALLOW_TRUNCATE=yes: emptying ${existing} existing rows in the target" >&2
fi

# 個人データを含むので、作業ファイルは本人だけが読める場所に作り、終わったら消す。
umask 077
work_dir=$(mktemp -d)
trap 'rm -rf "$work_dir"' EXIT

load_sql="${work_dir}/load.sql"
{
  echo "BEGIN;"
  echo "TRUNCATE $(IFS=,; echo "${TABLES[*]}") RESTART IDENTITY;"
} > "$load_sql"

for table in "${TABLES[@]}"; do
  columns=$(psql_run -At -c "SELECT string_agg(column_name, ',' ORDER BY ordinal_position) FROM information_schema.columns WHERE table_schema = 'public' AND table_name = '$table'")
  expressions=$(IFS=,; for column in $columns; do copy_expression "$column"; printf ','; done)
  expressions="${expressions%,}"

  data_file="${work_dir}/${table}.tsv"
  mysql_query "SELECT CONCAT_WS('\\t', ${expressions}) FROM \`${table}\` ORDER BY id" > "$data_file"
  if [ "$(LC_ALL=C tr -cd '\000' < "$data_file" | wc -c | tr -d ' ')" != "0" ]; then
    echo "${table} contains a NUL character, which PostgreSQL cannot store. Nothing was changed in PostgreSQL." >&2
    exit 1
  fi
  echo "exported ${table}: $(wc -l < "$data_file" | tr -d ' ') rows"

  {
    echo "\\copy ${table} (${columns}) FROM '${data_file}'"
    echo "SELECT setval(pg_get_serial_sequence('${table}', 'id'), COALESCE(MAX(id), 0) + 1, false) FROM ${table};"
  } >> "$load_sql"
done

echo "COMMIT;" >> "$load_sql"
psql_run -f "$load_sql" >/dev/null

for table in "${TABLES[@]}"; do
  echo "copied ${table}: $(psql_run -At -c "SELECT COUNT(*) FROM ${table}") rows"
done
