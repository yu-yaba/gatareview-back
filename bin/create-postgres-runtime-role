#!/usr/bin/env bash
# 本番の PostgreSQL に、アプリ用の最小権限ロール gatareview_runtime を作る（あればパスワードを変えて権限をそろえ直す）。
#
#   ADMIN_PG_URL='postgres://avnadmin:...@<host>:<port>/<db>?sslmode=verify-full&sslrootcert=config/certs/aiven-ca.pem' \
#   RUNTIME_URL_FILE=~/.gatareview-postgres-runtime-url \
#     bin/create-postgres-runtime-role
#
# - 付ける権限: public スキーマの全テーブルの SELECT/INSERT/UPDATE/DELETE と、シーケンスの USAGE/SELECT。
#   管理者（avnadmin）があとから作るテーブル・シーケンスにも同じ権限が付く（db:schema:load で作り直しても残る）。
# - 付けない権限: テーブルの作成・変更・削除、TRUNCATE、ロールやスキーマの作成。migration は管理者ユーザーで流す。
# - パスワードは手元で作り、サーバーには SCRAM-SHA-256 のハッシュだけを送る（サーバーのログに平文が残らない）。
#   アプリ用の接続先 URL（パスワード入り）は RUNTIME_URL_FILE に権限 600 で書く。画面には出さない。
#   Heroku の DATABASE_URL には、このファイルの URL の sslmode 以外のクエリを外したものを設定する。
set -euo pipefail

: "${ADMIN_PG_URL:?set ADMIN_PG_URL}"
: "${RUNTIME_URL_FILE:?set RUNTIME_URL_FILE}"
ROLE=gatareview_runtime

umask 077
sql_file=$(mktemp)
url_file=$(mktemp)
trap 'rm -f "$sql_file" "$url_file"' EXIT

# パスワードと SCRAM のハッシュを作り、URL と SQL を作業ファイルへ書く。

python3 -I - "$ADMIN_PG_URL" "$url_file" "$sql_file" "$ROLE" <<'PY'
import base64, hashlib, hmac, secrets, sys, urllib.parse as u

admin_url, runtime_file, sql_file, role = sys.argv[1:5]
password = secrets.token_urlsafe(32)
salt = secrets.token_bytes(16)
salted = hashlib.pbkdf2_hmac('sha256', password.encode(), salt, 4096)
client_key = hmac.new(salted, b'Client Key', 'sha256').digest()
server_key = hmac.new(salted, b'Server Key', 'sha256').digest()
b64 = lambda data: base64.b64encode(data).decode()
verifier = f"SCRAM-SHA-256$4096:{b64(salt)}${b64(hashlib.sha256(client_key).digest())}:{b64(server_key)}"

admin = u.urlsplit(admin_url)
database = admin.path.lstrip('/')
netloc = f"{role}:{u.quote(password, safe='')}@{admin.hostname}:{admin.port}"
query = 'sslmode=verify-full'
open(runtime_file, 'w').write(u.urlunsplit((admin.scheme, netloc, admin.path, query, '')))

open(sql_file, 'w').write(f"""\\set ON_ERROR_STOP on
BEGIN;
DO $$
BEGIN
  IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = '{role}') THEN
    ALTER ROLE {role} LOGIN PASSWORD '{verifier}' NOCREATEDB NOCREATEROLE NOINHERIT CONNECTION LIMIT 20;
  ELSE
    CREATE ROLE {role} LOGIN PASSWORD '{verifier}' NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT CONNECTION LIMIT 20;
  END IF;
END
$$;
GRANT CONNECT ON DATABASE "{database}" TO {role};
GRANT USAGE ON SCHEMA public TO {role};
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO {role};
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO {role};
ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO {role};
ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT USAGE, SELECT ON SEQUENCES TO {role};
COMMIT;
""")
PY

# SQL が成功したときだけ、新しいパスワードの URL を書き出す（失敗したら古い URL のまま残す）。
psql "$ADMIN_PG_URL" -X -q -f "$sql_file"
cat "$url_file" > "$RUNTIME_URL_FILE"
echo "${ROLE}: created or updated. The connection URL was written to ${RUNTIME_URL_FILE} (mode 600)."
